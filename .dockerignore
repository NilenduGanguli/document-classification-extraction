# Keep the build context small and the image free of anything that is not the service.
.git
.gitignore
.github
.venv
venv
env

__pycache__
**/__pycache__
*.py[cod]
*.egg-info
.pytest_cache
.ruff_cache
.mypy_cache
.coverage
htmlcov

tests
docs
*.md
# pyproject declares the readme, so the build needs this one back.
# (.dockerignore has no trailing-comment syntax — a comment here would become part of the
# pattern and silently stop the re-include from matching.)
!README.md

# The BERT checkpoint is mounted at runtime, never copied into the image (~1.3 GB).
models
data

# The console's dependencies and its committed bundle. The image compiles the bundle itself in
# the `ui` stage, so neither belongs in the build context: node_modules is large and
# platform-specific, and shipping the checkout's dist would mean the image served whatever was
# last built on somebody's laptop rather than the source in this commit.
frontend/node_modules
frontend/dist

.env
.env.*
*.pem
*.key
service-account.json

.DS_Store
.idea
.vscode
