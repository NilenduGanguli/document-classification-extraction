# =============================================================================
# Document Classification & Extraction (DCE) — example configuration
#
# Copy to .env and edit. EVERY value here is already the default: a deployment
# that copies this file and changes nothing gets the safe build — classification
# in-process, extraction local, zero egress, nothing billed.
#
# The two rules worth reading before you change anything:
#
#   1. Nothing about an UNCLASSIFIED document leaves this process. Not the
#      bytes, not the text, not an embedding of the text. That is enforced in
#      code (dce/egress.py), reported by /readyz, and it is why the base image
#      contains no HTTP client at all.
#   2. AFTER a doctype is accepted, calling out is allowed — that is the entire
#      point of the tiering. Every tier that can do it is OFF below, so if you
#      want none, do nothing.
# =============================================================================

# ---- Server ------------------------------------------------------------------
HOST=0.0.0.0
PORT=8200
# Empty disables the X-API-Key gate. Fine behind a mesh that already
# authenticates; not fine on anything reachable from a desk.
API_KEY=
DATA_DIR=./data

# ---- THE INVARIANT -----------------------------------------------------------
# Leave this false. True lets unclassified document content reach the network,
# which is the exact failure this service exists to prevent; it also makes
# /readyz return 503 and logs at error, so the change is visible rather than
# quiet. It is an auditable act, not a tuning knob.
ALLOW_PRECLASSIFICATION_EGRESS=false

# ---- Classification thresholds -----------------------------------------------
# Raising these raises the abstention rate (more human review, fewer silent
# mistakes); lowering them does the opposite. If abstentions climb, the fix is
# almost never a lower threshold — it is a missing doctype or a stale term
# profile. Watch dce_classifications_total{outcome="abstained"} first.
CLASSIFY_ACCEPT_PROBABILITY=0.65
CLASSIFY_MIN_MARGIN=0.25
CLASSIFY_MIN_COVERAGE=0.20

# Zone weights: the same word is worth 3.0 in a title and 0.25 in a page footer
# that repeats on all 40 pages. That ratio is most of what makes the lexical
# tier better than grep.
ZONE_WEIGHT_TITLE=3.0
ZONE_WEIGHT_HEADING=2.0
ZONE_WEIGHT_BODY=1.0
ZONE_WEIGHT_TABLE=1.2
ZONE_WEIGHT_FURNITURE=0.25

# ---- Optional LOCAL BERT tier (L3) — off ------------------------------------
# In-process, on a checkpoint you mounted; it is inside the invariant. Enable it
# only if anchors + lexical prove insufficient on your corpus, and install the
# `bert` extra deliberately. If the directory is missing, startup fails loudly.
BERT_ENABLED=false
BERT_MODEL_DIR=/models/bert_uncased_L-12_H-768_A-12
BERT_DEVICE=cpu

# ---- Extraction (T1, local) --------------------------------------------------
EXTRACT_ACCEPT_CONFIDENCE=0.60
LABEL_WINDOW_X=0.55
LABEL_WINDOW_Y=0.06
FUZZY_LABEL_MIN_SCORE=88

# =============================================================================
# EXTRACTION TIERS 2-4 — EGRESS AND SPEND. All off.
#
# These run only after a doctype has been accepted, only over fields the tiers
# before them could not fill, and only on /process. Each one bills. Turning one
# on is a per-deployment decision; leaving them alone is a complete deployment.
#
# They also need an HTTP client, which the base image deliberately does not
# have: build with --build-arg EXTRA_PACKAGES="httpx>=0.27" if you want them.
# =============================================================================

# ---- T2/T3: Azure Document Intelligence -------------------------------------
# T2 = prebuilt specialists (idDocument, tax.us.w2, bankStatement.us …), billed
#      per page, and only for the handful of doctypes Azure actually models.
# T3 = queryFields on the layout model: named fields no prebuilt model covers,
#      billed per field.
# Both send the ORIGINAL FILE to Azure, so the caller must pass content_base64
# on /process; without it they are skipped and say so.
T2_ENABLED=false
T3_ENABLED=false
AZURE_DI_ENDPOINT=
# Inject from a secret store at runtime. Never bake a key into an image.
AZURE_DI_KEY=
# Pinned, not "latest": a silently newer API version changes field names and
# confidence semantics under a pipeline that has already been signed off.
AZURE_DI_API_VERSION=2024-11-30
# Azure caps query fields per request and bills per field. This cap stops a
# doctype with 60 fields turning one page into one enormous invoice line.
T3_MAX_QUERY_FIELDS=20

# ---- T4: constrained LLM -----------------------------------------------------
# Last resort, for fields no deterministic locator and no Azure model could
# bind. The most expensive tier, the least predictable, and the only one that
# can produce a fluent, plausible, wrong value — so everything it returns is
# validated against the same FieldSpec pattern/validator as T1 and never gets
# promoted above format_valid without a checksum.
# Point LLM_BASE_URL at a self-hosted model to keep documents inside your own
# boundary; the tier does not care whose model it is.
T4_ENABLED=false
LLM_BASE_URL=
LLM_API_KEY=
# Pin the model id. "Whatever is newest" is not a reproducible extraction
# contract.
LLM_MODEL=

# ---- T5: human review queue --------------------------------------------------
# Not egress, and not optional: every abstention and every unverified required
# field lands here. `memory` is honest for a single replica and loses everything
# on restart; `file` persists to REVIEW_QUEUE_PATH. Anything durable and shared
# (a database, a workflow tool) implements dce.review.ReviewQueue and is the
# deploying team's to own.
REVIEW_QUEUE_BACKEND=memory
# Must be on a writable mount — the container's root filesystem is read-only and
# /app/data is the one volume.
REVIEW_QUEUE_PATH=./data/review_queue.json

# ---- Optional upstream (post-classification only) ---------------------------
# DES supplies a Layout payload when a caller sends a document id instead of the
# payload itself. Never called before classification.
DES_URL=
DES_API_KEY=
